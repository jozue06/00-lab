# --- Location ---
# Comma-separated cities to scan (recommended for metro areas)
SEARCH_LOCATIONS=Springfield, MO,Nixa, MO,Ozark, MO
# Search radius around each city center (~12 miles covers the metro)
SEARCH_RADIUS_METERS=20000

# Optional: center all searches on one point instead of geocoding each city
# SEARCH_LAT=37.15
# SEARCH_LNG=-93.25

# --- Google Places API ---
# Get a key at https://console.cloud.google.com/apis/credentials
# Enable: Places API (New) or Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_NAME=Your Name
FROM_EMAIL=your.email@gmail.com
REPLY_TO=your.email@gmail.com

# Physical mailing address (required for CAN-SPAM compliance in the US)
BUSINESS_ADDRESS=123 Main St, Springfield, MO 65802

# --- Outreach settings ---
# dry_run=true logs emails without sending; set false to actually send
DRY_RUN=true
MAX_EMAILS_PER_RUN=10
DELAY_BETWEEN_EMAILS_SECONDS=30

# Search terms (comma-separated)
SEARCH_QUERIES=catering,catering company,event catering,wedding catering
